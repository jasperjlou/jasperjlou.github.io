---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; detail?: boolean; }
const { project, detail = false } = Astro.props;
const { liveUrl, githubUrl, repositoryVisibility } = project.data;
---
<div class="project-links">
  <div class="button-row">
    {!detail && <a class="button button--accent" href={`/projects/${project.id}/`}>How it works</a>}
    {detail && liveUrl && <a class="button button--accent" href={liveUrl} target="_blank" rel="noopener noreferrer">Open live project</a>}
    {repositoryVisibility === 'public'
      ? <a class="button" href={githubUrl} target="_blank" rel="noopener noreferrer">View source</a>
      : <a class="text-link" href="https://github.com/jasperjlou" target="_blank" rel="noopener noreferrer">My GitHub</a>}
  </div>
  {repositoryVisibility === 'private' && <small>The source repository is private; the project page documents the public architecture and implementation notes.</small>}
</div>
