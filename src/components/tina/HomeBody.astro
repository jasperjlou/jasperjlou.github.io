---
import { getCollection } from 'astro:content';
import { tinaField } from '@tinacms/astro/tina-field';
import ProjectVisual from '@/components/ProjectVisual.astro';
import PostCard from '@/components/PostCard.astro';
import type { CmsHome } from '@/lib/tina/data';

interface Props { data?: CmsHome | null; }
const { data } = Astro.props;
const sections = data?.sections ?? [];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const project = projects[0];
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = posts.slice(0, 4);

const sectionKind = (section: any) => {
  if (section?._template) return section._template;
  const typeName = String(section?.__typename ?? '');
  if (typeName.endsWith('FeaturedProject')) return 'featuredProject';
  if (typeName.endsWith('LatestNotes')) return 'latestNotes';
  if (typeName.endsWith('Hero')) return 'hero';
  return '';
};
---

{sections.map((section: any) => {
  const kind = sectionKind(section);

  if (kind === 'hero') return (
    <section class="home-hero" data-tina-field={tinaField(section)}>
      <div class="shell home-hero__grid">
        <div class="home-hero__intro" data-reveal>
          <p class="eyebrow" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
          <h1 class="display-title">
            <span data-tina-field={tinaField(section, 'titleFirst')}>{section.titleFirst}</span><br />
            <span data-tina-field={tinaField(section, 'titleAccent')}>{section.titleAccent}</span>{' '}
            <span data-tina-field={tinaField(section, 'titleLast')}>{section.titleLast}</span>
          </h1>
          <p class="home-hero__lead" data-tina-field={tinaField(section, 'lead')}>{section.lead}</p>
        </div>
        <aside class="home-hero__aside" data-reveal>
          <p data-tina-field={tinaField(section, 'aside')}>{section.aside}</p>
          {section.facts?.map((fact: any) => (
            <div class="hero-index" data-tina-field={tinaField(fact)}>
              <span data-tina-field={tinaField(fact, 'label')}>{fact.label}</span>
              <small data-tina-field={tinaField(fact, 'value')}>{fact.value}</small>
            </div>
          ))}
        </aside>
      </div>
    </section>
  );

  if (kind === 'featuredProject' && project) return (
    <section class="featured-project" data-tina-field={tinaField(section)}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
            <h2><span data-tina-field={tinaField(section, 'titleFirst')}>{section.titleFirst}</span><br /><span data-tina-field={tinaField(section, 'titleLast')}>{section.titleLast}</span></h2>
          </div>
          <p data-tina-field={tinaField(section, 'intro')}>{section.intro}</p>
        </div>

        <div class="featured-project__grid">
          <div class="featured-project__copy" data-reveal>
            <div class="status-line">{project.data.status}</div>
            <h3>{project.data.title}<small>{project.data.englishTitle}</small></h3>
            <p>{project.data.description}</p>
            <div class="button-row">
              <a class="button button--accent" href={`/projects/${project.id}/`}>进入项目专题</a>
              <a class="button" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">打开产品</a>
            </div>
          </div>
          <div data-reveal>
            <ProjectVisual image={project.data.heroImage} alt={project.data.heroAlt} compact />
          </div>
        </div>

        <div class="metric-strip" data-reveal>
          {project.data.metrics.map((metric) => (
            <div class="metric-strip__item"><strong>{metric.value}</strong><span>{metric.label}</span></div>
          ))}
        </div>
      </div>
    </section>
  );

  if (kind === 'latestNotes') return (
    <section class="latest-notes" data-tina-field={tinaField(section)}>
      <div class="shell">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow" data-tina-field={tinaField(section, 'eyebrow')}>{section.eyebrow}</p>
            <h2><span data-tina-field={tinaField(section, 'titleFirst')}>{section.titleFirst}</span><br /><span data-tina-field={tinaField(section, 'titleLast')}>{section.titleLast}</span></h2>
          </div>
          <p data-tina-field={tinaField(section, 'intro')}>{section.intro}</p>
        </div>
        <div class="post-list" data-reveal>
          {latestPosts.map((post, index) => <PostCard post={post} index={index} />)}
        </div>
        <div style="margin-top: 34px;"><a class="text-link" href="/notes/" data-tina-field={tinaField(section, 'linkLabel')}>{section.linkLabel}</a></div>
      </div>
    </section>
  );

  return null;
})}
