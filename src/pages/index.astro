---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeBody from '@/components/tina/HomeBody.astro';
import { getHome } from '@/lib/tina/data';
import { islands } from '@/lib/tina/islands';

const result = await getHome();
const home = result.data?.home;
if (!home) return new Response('Home content not found', { status: 404 });
---

<BaseLayout title={home.seoTitle} description={home.seoDescription}>
  <TinaIsland name="home" wrapper={islands.home.wrapper} primary>
    <HomeBody data={home} />
  </TinaIsland>
</BaseLayout>
