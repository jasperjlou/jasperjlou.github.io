---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { toTaxonomySlug } from '@/data/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Notes" description="Development notes, project decisions, and computer science learning records by Jasper Jiarui Lou.">
  <section class="page-hero">
    <div class="shell page-hero__grid">
      <div data-reveal><p class="eyebrow">Notes</p><h1>Keep the timeline,<br />not only the polished result</h1></div>
      <aside class="page-hero__aside" data-reveal>
        <p>Some notes record things that worked; others preserve a wrong turn and the reasoning that followed. Project pages describe the current system, while dated posts remain snapshots of what I thought at the time.</p>
        <div class="notes-controls">
          {tags.map((tag) => <a href={`/tags/${toTaxonomySlug(tag)}/`}>{tag}</a>)}
        </div>
      </aside>
    </div>
  </section>
  <section class="notes-page">
    <div class="shell post-list" data-reveal>
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>
</BaseLayout>
