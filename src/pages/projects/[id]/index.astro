---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import PostCard from '@/components/PostCard.astro';
import { formatDate } from '@/data/site';
import ProjectPipeline from '@/components/ProjectPipeline.astro';
import ProjectLinks from '@/components/ProjectLinks.astro';
import { PROJECT_GROUPS } from '@/data/project-groups';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const group = PROJECT_GROUPS.find((group) => group.id === project.data.category)!;
const { Content } = await render(project);
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.project === project.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={project.data.title} description={project.data.description} image={project.data.heroImage}>
  <section class="project-hero">
    <div class="shell">
      <div class="project-hero__top">
        <div data-reveal>
          <a class="eyebrow" href={`/projects/#${group.id}`}>{group.title}</a>
          <p class="project-date">Project {String(project.data.order).padStart(2, '0')} · {project.data.launched}</p>
          <h1>{project.data.title}<small>{project.data.englishTitle}</small></h1>
        </div>
        <aside class="project-hero__summary" data-reveal>
          <div class="status-line">{project.data.status}</div>
          <p>{project.data.description}</p>
          <ProjectLinks project={project} detail />
        </aside>
      </div>
      <div data-reveal>
        {project.data.visual === 'campus' && project.data.heroImage
          ? <ProjectVisual image={project.data.heroImage} alt={project.data.heroAlt ?? project.data.title} />
          : <ProjectPipeline name={project.data.englishTitle} steps={project.data.pipeline} />}
      </div>
      {project.data.metrics.length > 0 && <div class="metric-strip" data-reveal>
        {project.data.metrics.map((metric) => (
          <div class="metric-strip__item" title={metric.note}>
            <strong>{metric.value}</strong><span>{metric.label}</span>
          </div>
        ))}
      </div>}
    </div>
  </section>

  <section class="project-overview shell">
    <aside class="project-overview__label" data-reveal>
      <p class="eyebrow">Why it exists</p>
      <span>资料核对于 {formatDate(project.data.lastVerified)}</span>
    </aside>
    <div class="project-overview__copy" data-reveal><Content /></div>
  </section>

  <section class="project-features">
    <div class="shell">
      <div class="project-features__header" data-reveal>
        <div><p class="eyebrow">Implementation</p><h2>{project.data.technicalTitle}</h2></div>
        <p>{project.data.statusDetail}</p>
      </div>
      <div class="feature-list" data-reveal>
        {project.data.features.map((feature) => (
          <article class="feature-item">
            <span>{feature.index}</span>
            <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {project.data.engineering.length > 0 && <section class="engineering-section shell" aria-label="技术取舍">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Engineering notes</p><h2>具体怎么做</h2></div>
      <p>这里记下实现方法和选择它的原因。</p>
    </div>
    <dl class="engineering-list">
      {project.data.engineering.map((item) => <div data-reveal><dt>{item.title}</dt><dd>{item.detail}</dd></div>)}
    </dl>
    {project.data.evidence.length > 0 && <div class="evidence-links"><span>代码与验证</span>{project.data.evidence.map((item) => <a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.label}</a>)}</div>}
  </section>}

  <section class="project-principles">
    <div class="shell project-principles__grid">
      <div data-reveal>
        <p class="eyebrow">Before using it</p>
        <h2>先看哪些能信，<br />哪些还要确认。</h2>
      </div>
      <div data-reveal>
        <ol class="principle-list">
          {project.data.principles.map((principle) => <li>{principle}</li>)}
        </ol>
        <div class="stack-line">{project.data.stack.map((item) => <span>{item}</span>)}</div>
      </div>
    </div>
  </section>

  {posts.length > 0 && <section class="project-timeline">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Development log</p><h2>从第一版继续写</h2></div>
        <p>这些文章保留项目当时的样子。我当时怎么想、怎么取舍、哪里做错了，都留在原文里。</p>
      </div>
      <div class="post-list" data-reveal>
        {posts.map((post, index) => <PostCard post={post} index={index} />)}
      </div>
    </div>
  </section>}
  <div class="shell project-back"><a class="text-link" href={`/projects/#${group.id}`}>回到 {group.title}</a></div>
</BaseLayout>
