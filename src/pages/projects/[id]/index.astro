---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import PostCard from '@/components/PostCard.astro';
import { formatDate } from '@/data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.project === project.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={project.data.title} description={project.data.description} image={project.data.heroImage}>
  <section class="project-hero">
    <div class="shell">
      <div class="project-hero__top">
        <div data-reveal>
          <p class="eyebrow">Project 01 · Since {project.data.launched}</p>
          <h1>{project.data.title}<small>{project.data.englishTitle}</small></h1>
        </div>
        <aside class="project-hero__summary" data-reveal>
          <div class="status-line">{project.data.status}</div>
          <p>{project.data.description}</p>
          <div class="button-row">
            <a class="button button--accent" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">在线体验</a>
            <a class="button" href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </aside>
      </div>
      <div data-reveal><ProjectVisual image={project.data.heroImage} alt={project.data.heroAlt} /></div>
      <div class="metric-strip" data-reveal>
        {project.data.metrics.map((metric) => (
          <div class="metric-strip__item" title={metric.note}>
            <strong>{metric.value}</strong><span>{metric.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="project-overview shell">
    <aside class="project-overview__label" data-reveal>
      <p class="eyebrow">Why it exists</p>
      <span>数据核验于 {formatDate(project.data.lastVerified)}</span>
    </aside>
    <div class="project-overview__copy" data-reveal><Content /></div>
  </section>

  <section class="project-features">
    <div class="shell">
      <div class="project-features__header" data-reveal>
        <div><p class="eyebrow">Current product</p><h2>从查课到排课，<br />都接进一份规划。</h2></div>
        <p>{project.data.statusDetail}</p>
      </div>
      <div class="feature-list" data-reveal>
        {project.data.features.map((feature) => (
          <article class="feature-item">
            <span>{feature.index}</span>
            <div><h3>{feature.title}</h3><p>{feature.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="project-principles">
    <div class="shell project-principles__grid">
      <div data-reveal>
        <p class="eyebrow">Before using it</p>
        <h2>先看哪些能信，<br />哪些还要确认。</h2>
      </div>
      <div data-reveal>
        <ol class="principle-list">
          {project.data.principles.map((principle) => <li>{principle}</li>)}
        </ol>
        <div class="stack-line">{project.data.stack.map((item) => <span>{item}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="project-timeline">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Development log</p><h2>全人助手，<br />从第一版继续写。</h2></div>
        <p>这些文章按时间记录每一版全人助手。我当时怎么想、怎么取舍、哪里做错了，都保留在原文里。</p>
      </div>
      <div class="post-list" data-reveal>
        {posts.map((post, index) => <PostCard post={post} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>
