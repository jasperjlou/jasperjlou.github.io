---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectVisual from '@/components/ProjectVisual.astro';
import ProjectPipeline from '@/components/ProjectPipeline.astro';
import ProjectLinks from '@/components/ProjectLinks.astro';
import { PROJECT_GROUPS } from '@/data/project-groups';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Research-oriented and engineering projects by Jasper Jiarui Lou: CUHKSZ MicroWorld, Holistic Assistant, Market Watchdog, and AI Sync.">
  <section class="page-hero">
    <div class="shell page-hero__grid">
      <div data-reveal>
        <p class="eyebrow">Projects</p>
        <h1>Systems I build,<br />test, and keep revising</h1>
      </div>
      <aside class="page-hero__aside" data-reveal>
        <p>These projects span agent environments, academic planning, market intelligence, and AI infrastructure. Each page focuses on what the system actually does, how it is structured, what has been verified, and what remains a limitation.</p>
        <a class="text-link" href="https://github.com/jasperjlou" target="_blank" rel="noopener noreferrer">github.com/jasperjlou</a>
      </aside>
    </div>
  </section>

  <nav class="shell project-category-nav" aria-label="Project categories">
    {PROJECT_GROUPS.map((group) => <a href={`#${group.id}`}>{group.title}<small>{projects.filter((p) => p.data.category === group.id).length} project(s)</small></a>)}
  </nav>
  <div class="project-index">
    <div class="shell">
      {PROJECT_GROUPS.map((group) => (
      <section class="project-group" id={group.id} aria-labelledby={`${group.id}-title`}>
        <header class="project-group__heading">
          <div><h2 id={`${group.id}-title`}>{group.title}</h2><span>{group.subtitle}</span></div><p>{group.description}</p>
        </header>
      {projects.filter((project) => project.data.category === group.id).map((project) => (
        <article class="project-index__feature">
          <div data-reveal>
            <span class="project-index__number">PROJECT · {String(project.data.order).padStart(2, '0')}</span>
            <div class="status-line" style="margin-top: 24px;">{project.data.status}</div>
            <h3>{project.data.title}<small>{project.data.englishTitle}</small></h3>
            <p>{project.data.summary}</p>
            <div class="stack-line" aria-label="Technology stack">{project.data.stack.slice(0, 5).map((item) => <span>{item}</span>)}</div>
            <ProjectLinks project={project} />
          </div>
          <div data-reveal>
            {project.data.visual === 'campus' && project.data.heroImage
              ? <ProjectVisual image={project.data.heroImage} alt={project.data.heroAlt ?? project.data.title} compact />
              : <ProjectPipeline name={project.data.englishTitle} steps={project.data.pipeline} compact />}
          </div>
        </article>
      ))}
      </section>
      ))}
    </div>
  </div>
</BaseLayout>
